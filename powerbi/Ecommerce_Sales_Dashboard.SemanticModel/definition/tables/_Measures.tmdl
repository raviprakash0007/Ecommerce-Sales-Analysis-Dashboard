table _Measures
	lineageTag: 4c37ce9f-4a83-4969-9696-d1eaf6ffce43

	measure 'Total Sales' = SUM ( fact_orders[Sales] )
		formatString: """₹""#,##0"""
		lineageTag: 2a500762-fc10-491c-a84c-b25de364aed1

	measure 'Total Profit' = SUM ( fact_orders[Profit] )
		formatString: """₹""#,##0"""
		lineageTag: e815cd79-d861-4b27-b332-f6fae4e64c60

	measure 'Total Orders' = DISTINCTCOUNT ( fact_orders[OrderID] )
		formatString: #,##0
		lineageTag: 1568655f-aa96-40e8-b4c9-49759e81832f

	measure 'Total Customers' = DISTINCTCOUNT ( fact_orders[CustomerID] )
		formatString: #,##0
		lineageTag: 0ec01357-b403-4b76-96a9-30f5dafe6dc9

	measure 'Total Quantity' = SUM ( fact_orders[Qty] )
		formatString: #,##0
