table dim_customers
	lineageTag: b951a578-220b-45c7-afd9-70e52d731835

	column CustomerID
		dataType: string
		lineageTag: 0661307a-9f82-4010-ae96-aa5ee0ca94eb
		summarizeBy: none
		sourceColumn: CustomerID

	column CustomerName
		dataType: string
		lineageTag: 3b49ca2f-a67c-43e2-a3f4-892ecbf2a5d7
		summarizeBy: none
		sourceColumn: CustomerName

	column Segment
		dataType: string
		lineageTag: 6565f06c-2013-43be-a298-f1188fba8c83
		summarizeBy: none
		sourceColumn: Segment

	column 'Customer Sales' = CALCULATE ( SUM ( fact_orders[Sales] ) )
		dataType: int64
		formatString: """₹""#,##0"""
		lineageTag: 9df34b6e-907c-4a93-ba66-80cc30735cea
		summarizeBy: none

	column 'Customer Profit' = CALCULATE ( SUM ( fact_orders[Profit] ) )
		dataType: int64
		formatString: """₹""#,##0"""
		lineageTag: f4bd94fa-1a33-482b-8e34-8f6496aea9bb
		summarizeBy: none

	column 'Customer Orders' = CALCULATE ( COUNTROWS ( fact_orders ) )
		dataType: int64
		formatString: 0
		lineageTag: ac04c9b0-63a7-4e5d-9997-a2943d3e162b
		summarizeBy: none

	column 'Customer Sales Rank' = RANKX ( dim_customers, dim_customers[Customer Sales], , DESC, DENSE )
		dataType: int64
		formatString: 0
		lineageTag: 1961ab84-5eab-4812-83f7-a5db17053ff3
		summarizeBy: none

	column 'Top 10 Flag' = IF ( dim_customers[Customer Sales Rank] <= 10, "Top 10", "Others" )
		dataType: string
		lineageTag: 2133581d-8c51-4491-9327-8189f62c5003
		summarizeBy: none

	column 'Buyer Type' = IF ( dim_customers[Customer Orders] > 1, "Repeat Buyer", "One-time Buyer" )
		dataType: string
		lineageTag: 5b6023b6-831b-41ed-b857-b65465ba3d75
		summarizeBy: none

	partition dim_customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Binary.Decompress(Binary.FromText("" & "", BinaryEncoding.Base64), Compression.Deflate),
				        [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {{"CustomerID", type text}, {"CustomerName", type text}, {"Segment", type text}},
				        "en-US"
				    ),
				    Cleaned = Table.TransformColumns(
				        Typed,
				        {
				            {"CustomerID", each Text.Upper(Text.Trim(_)), type text},
				            {"CustomerName", each Text.Proper(Text.Trim(_)), type text},
				            {
				                "Segment",
				                each
				                    let s = Text.Upper(Text.Trim(_))
				                    in if s = "VIP" then "VIP" else Text.Proper(s),
				                type text
				            }
				        }
				    ),
				    FilledSegment = Table.ReplaceValue(
				        Cleaned,
				        null,
				        "New",
				        Replacer.ReplaceValue,
				        {"Segment"}
				    ),
				    NoMissing = Table.SelectRows(FilledSegment, each [CustomerID] <> null and [CustomerID] <> ""),
				    NoDuplicates = Table.Distinct(NoMissing, {"CustomerID"}),
				    Sorted = Table.Sort(NoDuplicates, {{"CustomerID", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table

