table fact_payments
	lineageTag: 1258f03c-532e-44f9-8441-92b043901d29

	column TransactionID
		dataType: string
		lineageTag: 718b4f23-a683-4e10-bfe0-faf4bf8dceb0
		summarizeBy: none
		sourceColumn: TransactionID

	column OrderID
		dataType: string
		lineageTag: 81e6c9e8-9d81-4773-ba42-1b35467962d5
		summarizeBy: none
		sourceColumn: OrderID

	column PaymentMode
		dataType: string
		lineageTag: c08f0399-0641-4108-bc07-a0c663454985
		summarizeBy: none
		sourceColumn: PaymentMode

	column Amount
		dataType: int64
		formatString: """₹""#,##0"""
		lineageTag: 7d248787-3eb6-44e3-954a-7d5ca0bc13ec
		summarizeBy: sum
		sourceColumn: Amount

	column 'Order Date' = RELATED ( fact_orders[OrderDate] )
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 04572d3d-bb9d-4d50-830a-e3893f524171
		summarizeBy: none

	column 'Payment Month' = DATE ( YEAR ( fact_payments[Order Date] ), MONTH ( fact_payments[Order Date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 44149ee5-1f4c-42c0-a744-c7db2ab2a06b
		summarizeBy: none

	column 'Payment Month Name' = FORMAT ( fact_payments[Order Date], "mmm" )
		dataType: string
		lineageTag: 6f030f08-93f8-4cdd-9f89-3fdb1708f51d
		summarizeBy: none

	column 'Payment Channel' =
			SWITCH (
			    fact_payments[PaymentMode],
			    "UPI",   "Digital",
			    "Cards", "Digital",
			    "EMI",   "Credit / Instalment",
			    "Cash",  "Offline",
			    "Other"
			)
		dataType: string
		lineageTag: de5b7b9b-6a54-4dc7-ab08-62384e5dd1c8
		summarizeBy: none

	column 'Ticket Size Band' =
			SWITCH (
			    TRUE (),
			    fact_payments[Amount] < 1000, "1. Under 1K",
			    fact_payments[Amount] < 3000, "2. 1K - 3K",
			    fact_payments[Amount] < 6000, "3. 3K - 6K",
			    "4. 6K and above"
			)
		dataType: string
		lineageTag: 89d1566b-b5c0-4bdd-a8b5-cc59f49fd7ca
		summarizeBy: none

	partition fact_payments = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Binary.Decompress(Binary.FromText("" & "" & "" & "" & "", BinaryEncoding.Base64), Compression.Deflate),
				        [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {{"TransactionID", type text}, {"OrderID", type text}, {"PaymentMode", type text}, {"Amount", Int64.Type}},
				        "en-US"
				    ),
				    Normalised = Table.TransformColumns(
				        Typed,
				        {
				            {"TransactionID", each Text.Upper(Text.Trim(_)), type text},
				            {"OrderID", each Text.Upper(Text.Trim(_)), type text},
				            {
				                "PaymentMode",
				                each
				                    let m = Text.Upper(Text.Trim(_))
				                    in
				                        if m = "UPI" then "UPI"
				                        else if m = "EMI" then "EMI"
				                        else if m = "CARD" or m = "CARDS" then "Cards"
				                        else if m = "CASH" then "Cash"
				                        else m,
				                type text
				            }
				        }
				    ),
				    NoDuplicates = Table.Distinct(Normalised, {"TransactionID"}),
				    NoMissing = Table.SelectRows(
				        NoDuplicates,
				        each [TransactionID] <> null and [OrderID] <> null and [PaymentMode] <> null
				            and [Amount] <> null and [Amount] > 0
				    ),
				    Joined = Table.NestedJoin(NoMissing, {"OrderID"}, fact_orders, {"OrderID"}, "ord", JoinKind.Inner),
				    Clean = Table.RemoveColumns(Joined, {"ord"})
				in
				    Clean

	annotation PBI_ResultType = Table

