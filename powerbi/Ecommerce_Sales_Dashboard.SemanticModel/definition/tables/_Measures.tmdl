	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Total Orders] )
		formatString: """₹""#,##0"""
		lineageTag: 5719dfd6-137a-4c77-af5e-da485c0956ac

	measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.0%
		lineageTag: 018c0a28-2854-4bdc-b014-b8d659b05150

	measure 'Orders per Customer' = DIVIDE ( [Total Orders], [Total Customers] )
