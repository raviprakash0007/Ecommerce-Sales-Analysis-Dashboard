	measure 'Sales MoM Label' =
			VAR _v = [Sales MoM %]
			RETURN IF ( ISBLANK ( _v ), "-", IF ( _v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _v ), "0.0%" ) & " vs. last month" )
		lineageTag: 19f36635-4960-4332-98e1-c4c72496cc7b

