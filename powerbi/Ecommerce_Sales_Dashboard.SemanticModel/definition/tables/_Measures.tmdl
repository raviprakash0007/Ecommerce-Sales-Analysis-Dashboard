	measure 'Sales (Lakh)' = DIVIDE ( [Total Sales], 100000 )
		formatString: """₹""0.0""L"""
		lineageTag: cc46de64-78fc-4264-91d0-8f1052055f5d

	measure 'Last Order Date' = MAX ( fact_orders[OrderDate] )
		lineageTag: 8bd1ba13-dd4e-4210-b925-f2c4be9be33c

	measure 'Current Month Start' =
			VAR _d = [Last Order Date]
			RETURN DATE ( YEAR ( _d ), MONTH ( _d ), 1 )
		lineageTag: d3d550bc-f314-4737-b6ff-e65ba2913431

	measure 'Sales CM' =
			VAR _m = [Current Month Start]
			RETURN CALCULATE ( [Total Sales], REMOVEFILTERS ( dim_date ), dim_date[MonthStart] = _m )
		formatString: """₹""#,##0"""
		lineageTag: 42c1c5ea-a8a9-45a9-8376-8e6fdefa8688

	measure 'Sales LM' =
			VAR _m = EDATE ( [Current Month Start], -1 )
			RETURN CALCULATE ( [Total Sales], REMOVEFILTERS ( dim_date ), dim_date[MonthStart] = _m )
		formatString: """₹""#,##0"""
		lineageTag: c46348be-4b78-4342-b720-e54845e500d7

	measure 'Sales MoM %' = DIVIDE ( [Sales CM] - [Sales LM], [Sales LM] )
		formatString: 0.0%
		lineageTag: f6745185-c328-424d-9e32-242cb82c3635

	measure 'Profit CM' =
			VAR _m = [Current Month Start]
			RETURN CALCULATE ( [Total Profit], REMOVEFILTERS ( dim_date ), dim_date[MonthStart] = _m )
		formatString: """₹""#,##0"""
		lineageTag: 4e5053d6-dc88-4c29-90c6-19acdf2e501c

	measure 'Profit LM' =
			VAR _m = EDATE ( [Current Month Start], -1 )
