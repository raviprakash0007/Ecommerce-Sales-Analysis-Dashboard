table fact_orders
	lineageTag: ea18ab96-3096-42df-8529-b5c80a677fbd

	column OrderID
		dataType: string
		lineageTag: 01857a0b-b22f-4384-8a9e-c2e958cfaae0
		summarizeBy: none
		sourceColumn: OrderID

	column OrderDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 82d5e7f9-b7b5-42f4-9821-ba802eb8ce61
		summarizeBy: none
		sourceColumn: OrderDate

	column CustomerID
		dataType: string
		lineageTag: 051220e3-bac0-4502-afd3-8f7c828d09d6
		summarizeBy: none
		sourceColumn: CustomerID

	column ProductID
		dataType: string
		lineageTag: 1f6d8865-a3a5-4dc8-b54d-04618e485b15
		summarizeBy: none
		sourceColumn: ProductID

	column LocationID
		dataType: string
		lineageTag: 06109357-9b5a-4bbf-b0cd-d1fac0f65915
		summarizeBy: none
		sourceColumn: LocationID

	column Qty
		dataType: int64
		formatString: #,##0
		lineageTag: fff8a817-ccb7-4740-a525-c1e62732e465
		summarizeBy: sum
		sourceColumn: Qty

	column Sales
		dataType: int64
		formatString: """₹""#,##0"""
		lineageTag: 14678714-aa8e-45c3-a082-3634e9c5b808
		summarizeBy: sum
		sourceColumn: Sales

	column Profit
		dataType: int64
		formatString: """₹""#,##0"""
		lineageTag: 3d603ee3-7264-4fdf-9930-7fd2c41042b6
		summarizeBy: sum
		sourceColumn: Profit

	column Status
		dataType: string
		lineageTag: cc146979-15e5-46a9-9c25-d86d95de37ee
		summarizeBy: none
		sourceColumn: Status

	column 'Order Margin %' = DIVIDE ( fact_orders[Profit], fact_orders[Sales] )
		dataType: double
		formatString: 0.0%
		lineageTag: b5ce46e0-4bd5-4f5f-ba4d-7e934c4056b9
		summarizeBy: none

	column 'Realized Unit Price' = DIVIDE ( fact_orders[Sales], fact_orders[Qty] )
		dataType: double
		formatString: #,##0
		lineageTag: 93727a4e-c098-4e9a-ba5f-f71d81691deb
		summarizeBy: none

	column 'Order Value Band' =
			SWITCH (
			    TRUE (),
			    fact_orders[Sales] < 2000,  "1. Under 2K",
			    fact_orders[Sales] < 5000,  "2. 2K - 5K",
			    fact_orders[Sales] < 10000, "3. 5K - 10K",
			    fact_orders[Sales] < 20000, "4. 10K - 20K",
			    "5. 20K and above"
			)
		dataType: string
		lineageTag: 9b43dfea-4f23-4db1-b13c-f7d5de2fa6d2
		summarizeBy: none

	column 'Is Cancelled' = IF ( fact_orders[Status] = "Cancelled", 1, 0 )
		dataType: int64
		formatString: 0
		lineageTag: f299deb9-d1ec-463e-9f77-7bc2e70aadc5
		summarizeBy: none

	column 'Order Month' = DATE ( YEAR ( fact_orders[OrderDate] ), MONTH ( fact_orders[OrderDate] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: bfbd8347-411f-4707-8d08-c71fe9309688
		summarizeBy: none

	column 'Order Quarter' = "Q" & ROUNDUP ( MONTH ( fact_orders[OrderDate] ) / 3, 0 )
		dataType: string
		lineageTag: 72e946ea-56f2-42b2-abf6-4126bad70d73
		summarizeBy: none

	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Binary.Decompress(Binary.FromText("" & "" & "" & "", BinaryEncoding.Base64), Compression.Deflate),
				        [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"OrderID", type text}, {"OrderDate", type date}, {"CustomerID", type text},
				            {"ProductID", type text}, {"LocationID", type text}, {"Qty", Int64.Type},
				            {"Sales", Int64.Type}, {"Profit", Int64.Type}, {"Status", type text}
				        },
				        "en-US"
				    ),
				    Trimmed = Table.TransformColumns(
				        Typed,
				        {
				            {"OrderID", each Text.Upper(Text.Trim(_)), type text},
				            {"CustomerID", each Text.Upper(Text.Trim(_)), type text},
				            {"ProductID", each Text.Upper(Text.Trim(_)), type text},
				            {"LocationID", each Text.Upper(Text.Trim(_)), type text},
				            {"Status", each Text.Proper(Text.Trim(_)), type text}
				        }
				    ),
				    NoDuplicates = Table.Distinct(Trimmed, {"OrderID"}),
				    NoMissingKeys = Table.SelectRows(
				        NoDuplicates,
				        each [OrderID] <> null and [OrderID] <> ""
				            and [OrderDate] <> null and [CustomerID] <> null
				            and [ProductID] <> null and [LocationID] <> null
				    ),
				    FilledProfit = Table.ReplaceValue(NoMissingKeys, null, 0, Replacer.ReplaceValue, {"Profit"}),
				    FilledQty = Table.ReplaceValue(FilledProfit, null, 1, Replacer.ReplaceValue, {"Qty"}),
				    ValidRows = Table.SelectRows(
				        FilledQty,
				        each [Sales] <> null and [Sales] > 0 and [Qty] > 0
				            and List.Contains({"Delivered", "Shipped", "Cancelled"}, [Status])
				    ),
				    Sorted = Table.Sort(ValidRows, {{"OrderDate", Order.Ascending}, {"OrderID", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table

